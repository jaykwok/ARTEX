# Docker 部署配置（复制为 .env）
# 本地构建镜像时写入的版本号（显示在系统配置页）；留空为 dev
ARTEX_VERSION=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 私有 GitHub Release 更新（仅后端读取；令牌需 jaykwok/ARTEX 的 Contents: read；不用一键更新可留空）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
